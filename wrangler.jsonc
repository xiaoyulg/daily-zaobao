{
  "name": "daily-zaobao",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s", "/p/*", "/sitemap.xml", "/robots.txt", "/google7f159c18a03528a5.html", "/d0ffa14eae0540c69a4c70f8cfba92d0.txt"]
  },
  "triggers": {
    "crons": ["45 4 * * *"]
  },
  "kv_namespaces": [
    { "binding": "ZAOBAO_KV" }
  ]
}
