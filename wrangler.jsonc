{
  "name": "daily-zaobao",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/s", "/p/*", "/sitemap.xml", "/robots.txt", "/google7f159c18a03528a5.html"]
  },
  "kv_namespaces": [
    { "binding": "ZAOBAO_KV" }
  ]
}
